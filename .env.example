# ==============================================================================
# QGYM SYSTEM - ENVIRONMENT VARIABLES CONFIGURATION (PRODUCTION / VERCEL)
# ==============================================================================

# Database Connection URL (PostgreSQL recommended for Production / Vercel)
# Examples: Supabase, Neon.tech, Vercel Postgres, AWS RDS
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public&sslmode=require"

# JWT & Authentication Secrets (Generate secure random string for production)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"
NEXTAUTH_SECRET="your-super-secret-nextauth-key-minimum-32-characters"

# Public Application Branding & Settings
NEXT_PUBLIC_APP_NAME="QGYM Multi-Branch System"
NEXT_PUBLIC_DEFAULT_CURRENCY="EGP"

# Server Port (Optional, default 3000)
PORT=3000
